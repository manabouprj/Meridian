# Copy to .env (local / Docker). In Azure and AWS these come from Key Vault / Secrets Manager. Never commit .env.
MERIDIAN_API_KEYS=admin:change-me-32-chars-minimum-aaaaaaaaa,responder:change-me-32-chars-minimum-bbbbbbbb,analyst:change-me-32-chars-minimum-cccccccc
MERIDIAN_SESSION_SECRET=change-me-48-random-characters-for-signed-sessions-xx
MERIDIAN_INGEST_SECRET=change-me-ingest-hmac-secret-32-chars
MERIDIAN_EDL_TOKEN=change-me-edl-token-for-firewalls
MERIDIAN_METRICS_TOKEN=change-me-prometheus-token
MERIDIAN_AGENT_TOKENS=
MERIDIAN_DATABASE_URL=
MERIDIAN_PUBLIC_URL=https://meridian.your-org.example
MERIDIAN_LOG=INFO
MERIDIAN_LOG_FORMAT=json
# Microsoft Foundry (Claude in Foundry) - prefer managed identity; key only for local tests
FOUNDRY_RESOURCE=
ANTHROPIC_FOUNDRY_API_KEY=
# Amazon Bedrock - use an IAM role; region only
AWS_REGION=us-east-1
# SSO
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=
MERIDIAN_MCP_AUDIENCE=
# Notifications and LODESTAR hand-off
SLACK_WEBHOOK_URL=
TEAMS_WORKFLOW_URL=
LODESTAR_URL=
LODESTAR_ORG=
LODESTAR_WEBHOOK_SECRET=
