prefix           = "meridian"
location         = "uaenorth"        # data residency for the lake, database and compute
foundry_location = "eastus2"         # a region where your chosen Claude models are offered in Foundry
image            = "acrmeridian.azurecr.io/meridian:1.0.1"
acr_id           = "/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.ContainerRegistry/registries/acrmeridian"
enable_adx       = false

# LODESTAR integration (docs/integration/MERIDIAN-LODESTAR-INT-00.md); leave empty to switch it off
lodestar_url = "https://lodestar.internal.example"
lodestar_org = ""
