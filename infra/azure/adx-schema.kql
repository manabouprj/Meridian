// MERIDIAN on Azure Data Explorer (optional engine for large estates; set lake.query_engine: adx).
// Generated from meridian/ocsf.py by `python scripts/gen_adx_schema.py` - do not edit by hand.
// Run in the `meridian` database as a database admin, then create an Event Grid data connection on the
// lake storage account (container `lake`, prefix `events/`, event BlobCreated, format parquet,
// mapping MeridianParquet, managed identity) so every Parquet file the workers write is ingested.

.create-merge table MeridianEvents (['time']:datetime, ['class_uid']:int, ['class_name']:string, ['activity_name']:string, ['severity_id']:int, ['status']:string, ['product']:string, ['source']:string, ['user']:string, ['user_domain']:string, ['src_ip']:string, ['src_port']:int, ['src_country']:string, ['dst_ip']:string, ['dst_port']:int, ['dst_domain']:string, ['device']:string, ['device_id']:string, ['device_ip']:string, ['process_name']:string, ['process_cmdline']:string, ['parent_process_name']:string, ['file_name']:string, ['file_path']:string, ['file_sha256']:string, ['file_md5']:string, ['url']:string, ['http_method']:string, ['dns_query']:string, ['action']:string, ['auth_protocol']:string, ['mfa']:bool, ['app_name']:string, ['cloud_account']:string, ['cloud_region']:string, ['api_operation']:string, ['resource']:string, ['message']:string, ['tags']:string, ['ioc_hits']:string, ['event_uid']:string, ['raw']:string)

.create-or-alter table MeridianEvents ingestion parquet mapping 'MeridianParquet' '[{"column":"time","Properties":{"Path":"$.time"}}, {"column":"class_uid","Properties":{"Path":"$.class_uid"}}, {"column":"class_name","Properties":{"Path":"$.class_name"}}, {"column":"activity_name","Properties":{"Path":"$.activity_name"}}, {"column":"severity_id","Properties":{"Path":"$.severity_id"}}, {"column":"status","Properties":{"Path":"$.status"}}, {"column":"product","Properties":{"Path":"$.product"}}, {"column":"source","Properties":{"Path":"$.source"}}, {"column":"user","Properties":{"Path":"$.user"}}, {"column":"user_domain","Properties":{"Path":"$.user_domain"}}, {"column":"src_ip","Properties":{"Path":"$.src_ip"}}, {"column":"src_port","Properties":{"Path":"$.src_port"}}, {"column":"src_country","Properties":{"Path":"$.src_country"}}, {"column":"dst_ip","Properties":{"Path":"$.dst_ip"}}, {"column":"dst_port","Properties":{"Path":"$.dst_port"}}, {"column":"dst_domain","Properties":{"Path":"$.dst_domain"}}, {"column":"device","Properties":{"Path":"$.device"}}, {"column":"device_id","Properties":{"Path":"$.device_id"}}, {"column":"device_ip","Properties":{"Path":"$.device_ip"}}, {"column":"process_name","Properties":{"Path":"$.process_name"}}, {"column":"process_cmdline","Properties":{"Path":"$.process_cmdline"}}, {"column":"parent_process_name","Properties":{"Path":"$.parent_process_name"}}, {"column":"file_name","Properties":{"Path":"$.file_name"}}, {"column":"file_path","Properties":{"Path":"$.file_path"}}, {"column":"file_sha256","Properties":{"Path":"$.file_sha256"}}, {"column":"file_md5","Properties":{"Path":"$.file_md5"}}, {"column":"url","Properties":{"Path":"$.url"}}, {"column":"http_method","Properties":{"Path":"$.http_method"}}, {"column":"dns_query","Properties":{"Path":"$.dns_query"}}, {"column":"action","Properties":{"Path":"$.action"}}, {"column":"auth_protocol","Properties":{"Path":"$.auth_protocol"}}, {"column":"mfa","Properties":{"Path":"$.mfa"}}, {"column":"app_name","Properties":{"Path":"$.app_name"}}, {"column":"cloud_account","Properties":{"Path":"$.cloud_account"}}, {"column":"cloud_region","Properties":{"Path":"$.cloud_region"}}, {"column":"api_operation","Properties":{"Path":"$.api_operation"}}, {"column":"resource","Properties":{"Path":"$.resource"}}, {"column":"message","Properties":{"Path":"$.message"}}, {"column":"tags","Properties":{"Path":"$.tags"}}, {"column":"ioc_hits","Properties":{"Path":"$.ioc_hits"}}, {"column":"event_uid","Properties":{"Path":"$.event_uid"}}, {"column":"raw","Properties":{"Path":"$.raw"}}]'

// Hot cache and retention match the Terraform defaults (hot_cache_period P31D, soft_delete_period P400D)
.alter-merge table MeridianEvents policy retention softdelete = 400d recoverability = enabled

.alter table MeridianEvents policy caching hot = 31d

// The agents' identity needs only Viewer on the database:
// .add database meridian viewers ('aadapp=<workload identity client id>;<tenant id>') 'MERIDIAN agents'
